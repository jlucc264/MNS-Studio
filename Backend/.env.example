# Feature kill switch — see app/services/suspension.py. These FAIL CLOSED: a
# missing or misspelled variable leaves the feature suspended, so they have to
# be set explicitly even in development. Leaving them out of this file is why a
# fresh checkout serves a 503 from the gallery, checkout and every import tool
# while looking perfectly healthy otherwise.
#
# To suspend something, DELETE its line rather than setting it to "false" —
# absent is the only value a typo cannot accidentally undo.
IMPORT_ENABLED=true
CHECKOUT_ENABLED=true
GALLERY_ENABLED=true
